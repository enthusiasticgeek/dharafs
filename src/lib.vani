// DharaFS -- Tier 1 entry point: core filesystem only (see
// src/core.vani), with the media-encryption hook left as an
// extern "C" contract a consumer implements (or trivially stubs to
// always-off). This is the lean, default package -- `vanic add
// dharafs` resolves here (see vani.toml's own `entry` field).
//
// Want real ChaCha20-Poly1305 AEAD media encryption and SHA-256-
// verified companion-file I/O built in, with nothing left to
// implement yourself? Use "./lib_tier2.vani" instead of this file --
// see README.md's "Tier 2" section.

use "./core.vani";

// Media-encryption hook -- OPTIONAL. If you don't want this feature,
// provide a trivial stub: dharafs_crypto_get_enabled always returns 0
// (encrypt_block/decrypt_block then never get called at all).
extern "C" fn dharafs_crypto_get_enabled() -> u32;
extern "C" fn dharafs_crypto_encrypt_block(block_num: i64, plaintext: mut ref i64, out_ciphertext: mut ref i64) -> i64;
extern "C" fn dharafs_crypto_decrypt_block(block_num: i64, ciphertext: mut ref i64, out_plaintext: mut ref i64) -> i64;
